# 复制为 .env.local；只排盘不需要 Key。以下均为服务端变量，禁止 NEXT_PUBLIC_ 前缀。
# DeepSeek 官方 OpenAI 兼容接口；不填写真实密钥到版本库
DEEPSEEK_API_KEY=
# 默认 DeepSeek V4 Flash
DEEPSEEK_MODEL=deepseek-flash

# 两个 AI 接口共享每 IP 配额：每天（UTC）30 次，每分钟5次
AI_DAILY_LIMIT=30
AI_MINUTE_LIMIT=5

# 推荐生产配置：Upstash Redis REST 凭据；均不填则进程内 Map 尽力限流
# 只配置其中一项或 Redis 不可用时返回 503，不回退
# serverless 多实例不共享 Map，不能当作可靠的全站配额
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：逗号分隔 origin（含协议/端口），也支持主机名及 *.example.com
# 不设置时生产环境允许 tianjipan.tech、www.tianjipan.tech、*.vercel.app 和 localhost
# 设置后覆盖默认白名单；Origin/Referer 检查不是身份认证
# AI_ALLOWED_ORIGINS=https://tianjipan.tech,https://www.tianjipan.tech,http://localhost:3000

# 访问记录：Neon（未配置时静默关闭），详见 docs/OPERATIONS.md
DATABASE_URL=
# 兼容 Marketplace 注入的 POSTGRES_URL
POSTGRES_URL=
STATS_ADMIN_TOKEN=
CRON_SECRET=
STATS_EXCLUDE_IPS=
# 仅供本地统计 CLI
STATS_URL=https://tianjipan.tech

NEXT_PUBLIC_SITE_URL=https://tianjipan.tech
